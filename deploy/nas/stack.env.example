# Werte für den Stack (deploy/nas/docker-compose.yml).
#
# In Portainer unter "Environment variables" → "Advanced mode" mit echten Werten einfügen.
# In UGOS Pro ohne Portainer die Werte direkt in die Compose-Datei schreiben.

# ── Woher das Image kommt ─────────────────────────────────────────────────────
GHCR_OWNER=devsdaub
# latest = zuletzt gepushter Stand. Ein Kurz-Hash (sha-xxxxxxx, steht im Actions-Lauf)
# pinnt eine Version fest, der Rückweg, wenn ein Update Ärger macht.
SOLARANALYTICS_TAG=latest

# ── Erreichbarkeit ────────────────────────────────────────────────────────────
# 0.0.0.0 = aus dem Heimnetz erreichbar. Keine Portfreigabe im Router einrichten.
NAS_BIND=0.0.0.0
NAS_PORT=8009

# ── Datenbank (ersetzen!) ─────────────────────────────────────────────────────
DB_PASSWORD=hier-ein-eigenes-datenbank-passwort-eintragen

# ── Konfiguration auf dem NAS ─────────────────────────────────────────────────
# Ordner mit den YAML-Dateien. Ist er leer, legt der Container beim Start die
# Standarddateien hinein, ohne Hoymiles-Zugangsdaten.
NAS_CONFIG_PATH=/volume1/docker/solaranalytics/config

# ── Sonstiges ─────────────────────────────────────────────────────────────────
NAS_TZ=Europe/Berlin
